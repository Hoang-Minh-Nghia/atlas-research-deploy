# Cấu hình agent tin tức. Trên Windows script cài sẽ copy file này thành %LOCALAPPDATA%\atlas-news\atlas-news.env;
# chạy tay thì copy thành news_agent/.env. File thật KHÔNG được commit.

# ---- OpenRouter (viết lại bài) ----
OPENROUTER_API_KEY=__CHANGE_ME__
# Khoá riêng cho vai trò viết lại (tuỳ chọn, ưu tiên hơn OPENROUTER_API_KEY)
LLM_REWRITE_API_KEY=
# Ép một model (thử đầu tiên). Để trống = tự chọn model rẻ nhất trong danh mục đã kiểm định.
LLM_REWRITE_MODEL=
# Danh mục model, cách nhau bằng dấu phẩy. Để trống = danh mục mặc định trong news_agent/llm.py.
LLM_REWRITE_CATALOG=
LLM_MAX_TOKENS=3500

# ---- Tạo ảnh ----
# comfy = GPU máy này (ComfyUI + FLUX.2 klein qua lib/images.py của studio, $0)
# openrouter = model ảnh trả phí
IMAGE_BACKEND=comfy
# Đặt "openrouter" nếu muốn khi GPU bận/lỗi thì dùng OpenRouter thay vì chờ lượt sau
IMAGE_FALLBACK=
STUDIO_LIB_DIR=D:/youtube/studio/lib
# Python có torch/gguf/rembg mà studio đang dùng (để trống = python của venv agent)
STUDIO_PYTHON=
COMFY_URL=http://127.0.0.1:8188
# 1 = vẫn dùng ComfyUI đang chạy sẵn (mặc định nhường GPU cho studio)
COMFY_SHARED=0
COMFY_SIZE=1344x768
FIGURES_PER_ARTICLE=1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=__CHANGE_ME__
TELEGRAM_CHAT_ID=__CHANGE_ME__
TELEGRAM_ALLOWED_USER_IDS=__CHANGE_ME__

# ---- Nguồn và repo ----
SOURCE_URL=https://vnexpress.net/tag/tai-san-so-1064801
MAX_PER_RUN=3
DRAFT_TTL_DAYS=7
GIT_BRANCH=main
SITE_URL=https://atlas-research-vn.pages.dev
# Thư mục clone riêng của agent (agent tự reset --hard về origin/GIT_BRANCH mỗi lần đăng)
REPO_DIR=D:/atlas-news/repo
# Để trống = %LOCALAPPDATA%\atlas-news
STATE_DIR=
